{
  "name": "rsshub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:docs && npm run test:native-adapters",
    "test:docs": "node ./scripts/validate-route-docs.mjs",
    "test:native-adapters": "npm exec tsc -- -p tsconfig.native-adapters.json && node .tmp-native-adapters/tests/nativeFeedAdapters.test.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "pyyaml": "^0.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
